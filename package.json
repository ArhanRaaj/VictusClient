{
  "name": "victusclient",
  "version": "1.0.0",
  "description": "VictusClient - Premium Modern Minecraft Launcher & Client",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.electron.json",
